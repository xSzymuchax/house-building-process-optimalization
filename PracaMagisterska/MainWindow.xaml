<Window x:Class="PracaMagisterska.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PracaMagisterska"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid x:Name="DataInputGrid" Background="#FFBBBBBB" Margin="0,0,0,0" HorizontalAlignment="Right" Width="250">
            <!-- Parametry modyfikacji populacji-->
            <Label Content="Rozmiar populacji (α): " HorizontalAlignment="Left" Margin="10,9,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="AlphaTextBox" HorizontalAlignment="Left" Margin="190,13,0,0" Text="1" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <Label Content="Parametr krzyżowania (β): " HorizontalAlignment="Left" Margin="10,32,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="BetaTextBox" HorizontalAlignment="Left" Margin="190,36,0,0" Text="0,64" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <Label Content="Parametr mutacji (γ): " HorizontalAlignment="Left" Margin="10,55,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="GammaTextBox" HorizontalAlignment="Left" Margin="190,59,0,0" Text="0,28" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <Label Content="Parametr klonowania (δ): " HorizontalAlignment="Left" Margin="10,78,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="DeltaTextBox" HorizontalAlignment="Left" Margin="190,82,0,0" Text="0,08" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <!-- Parametry wag optymalizowanych wartości -->
            <Label Content="Waga kosztu (Kw): " HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="KwTextBox" HorizontalAlignment="Left" Margin="190,105,0,0" TextWrapping="Wrap" Text="0,5" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>
            <Label Content="Waga czasu (Cw): " HorizontalAlignment="Left" Margin="10,124,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="CwTextBox" HorizontalAlignment="Left" Margin="190,128,0,0" TextWrapping="Wrap" Text="0,5" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <!-- Kara -->
            <Label Content="Kara: " HorizontalAlignment="Left" Margin="10,147,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="PenaltyStrengthTextBox" HorizontalAlignment="Left" Margin="190,151,0,0" TextWrapping="Wrap" Text="2000" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <!-- Limity -->
            <CheckBox x:Name="TimeLimitCheckbox"  HorizontalAlignment="Left" Margin="18,198,0,0" VerticalAlignment="Top" Checked="TimeLimitCheckbox_Checked" Unchecked="TimeLimitCheckbox_Unchecked"/>
            <CheckBox x:Name="CostLimitCheckbox"  HorizontalAlignment="Left" Margin="18,221,0,0" VerticalAlignment="Top" Unchecked="CostLimitCheckbox_Unchecked" Checked="CostLimitCheckbox_Checked"/>
            <Label x:Name="TimeLimitLabel" Content="Limit czasu: " HorizontalAlignment="Left" Margin="34,193,0,0" VerticalAlignment="Top" IsEnabled="False"/>

            <TextBox x:Name="TimeLimitTextBox" HorizontalAlignment="Left" Margin="190,197,0,0" TextWrapping="Wrap" Text="100" VerticalAlignment="Top" Width="50" TextAlignment="Center" IsEnabled="False"/>
            <Label x:Name="CostLimitLabel" Content="Limit kosztu: " HorizontalAlignment="Left" Margin="34,216,0,0" VerticalAlignment="Top" IsEnabled="False"/>
            <TextBox x:Name="CostLimitTextBox" HorizontalAlignment="Left" Margin="190,220,0,0" TextWrapping="Wrap" Text="100" VerticalAlignment="Top" Width="50" TextAlignment="Center" IsEnabled="False"/>
            <TextBox x:Name="IterationStrategyTextBox" HorizontalAlignment="Left" Margin="190,273,0,0" TextWrapping="Wrap" Text="100" VerticalAlignment="Top" Width="50" TextAlignment="Center"/>

            <!-- Uruchomienie przetwarzania -->
            <Button x:Name="LoadFileButton" Content="Wczytaj Plik..." HorizontalAlignment="Left" Margin="17,298,0,0" VerticalAlignment="Top" Width="90" Click="LoadFileButton_Click"/>
            <Button x:Name="StartProcessingButton" Content="Rozpocznij" HorizontalAlignment="Left" Margin="150,298,0,0" VerticalAlignment="Top" IsEnabled="False" Width="90" Click="StartProcessingButton_Click"/>
            <ComboBox x:Name="IterationStrategyComboBox" HorizontalAlignment="Left" Margin="17,271,0,0" VerticalAlignment="Top" Width="168" SelectedIndex="0">
                <ComboBoxItem Content="Maksymalna liczba iteracji" />
                <ComboBoxItem Content="Liczba iteracji bez poprawy" />
            </ComboBox>

        </Grid>
        <Grid Margin="0,0,250,0" Background="White">
            <WindowsFormsHost Name="windowsFormsHost" />
        </Grid>
    </Grid>

</Window>
